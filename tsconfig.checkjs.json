{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "target": "ES2022",
        "module": "Node16",
        "moduleResolution": "Node16",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "skipLibCheck": true,
        "strict": false,
        "noImplicitAny": false,
        "noImplicitThis": false,
        "useUnknownInCatchVariables": false,
        "allowUnreachableCode": true,
        "allowUnusedLabels": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "types/**/*.d.ts",
        ".pisi-types/**/*.d.ts",
        "main.mjs",
        "preload.js",
        "main/**/*.js",
        "renderer/**/*.mjs",
        "shared/**/*.mjs",
        "scripts/**/*.js",
        "scripts/**/*.mjs"
    ],
    "exclude": ["node_modules", "dist", "android", "tests"]
}

<?xml version="1.0" encoding="utf-8"?>
<!--
    The cat on the paper (assets/pisi.png) alone, with no background of its own: the launcher's shape shows the wallpaper
    around it. The cat sits inside the 66 dp circle every launcher mask keeps; a soft shadow under the paper shows its
    edge on a light wallpaper.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/transparent" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Themed icons (Android 13): the launcher tints this shape with the wallpaper's colours. -->
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>

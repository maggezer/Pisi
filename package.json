{
  "name": "pisi",
  "version": "1.0.0",
  "description": "Pisi desktop knowledge mapping app",
  "main": "main.js",
  "author": "Mumin Biyiklioglu",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "rename:pisi": "node scripts/complete-pisi-rename.js",
    "check:syntax": "node scripts/check-syntax.js",
    "lint": "eslint .",
    "test": "node --test",
    "validate": "npm run check:syntax && npm run lint && npm test",
    "audit": "npm audit --audit-level=high",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.mumin.pisi",
    "productName": "Pisi",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app.js",
      "index.html",
      "style.css",
      "renderer/**/*",
      "assets/**/*",
      "locales/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/pisi.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pisi"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "eslint": "^10.8.0"
  }
}
